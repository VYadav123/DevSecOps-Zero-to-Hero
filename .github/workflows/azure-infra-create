- name: Fetch Azure creds from Vault
  uses: hashicorp/vault-action@v3
  with:
    url: http://<YOUR_EC2_IP>:8200
    role: gh-actions-role
    method: jwt
    secrets: |
      azure/creds/terraform-role client_id | ARM_CLIENT_ID ;
      azure/creds/terraform-role client_secret | ARM_CLIENT_SECRET ;
      azure/creds/terraform-role subscription_id | ARM_SUBSCRIPTION_ID ;
      azure/creds/terraform-role tenant_id | ARM_TENANT_ID
