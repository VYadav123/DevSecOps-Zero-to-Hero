# GitHub Actions workflow: Terraform deploy using Vault (Azure creds)
# - Fetches short-lived Azure SP credentials from Vault via JWT (OIDC)
# - Exposes them as ARM_* env vars for Terraform
# Replace http://104.211.113.12:8200 with your Vault address (use TLS in prod).
on:
  push:
    branches:
      - main

name: Terraform Deployment

permissions:
  id-token: write
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: ./terraform

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Fetch Azure creds from Vault
        uses: hashicorp/vault-action@v3
        id: vault
        with:
          url: http://<YOUR_EC2_IP>:8200
          role: gh-actions-role
          method: jwt
          # Map Vault response fields to environment variables for subsequent steps
          secrets: |
            azure/creds/terraform-role client_id   | ARM_CLIENT_ID ;
            azure/creds/terraform-role client_secret | ARM_CLIENT_SECRET ;
            azure/creds/terraform-role subscription_id | ARM_SUBSCRIPTION_ID ;
            azure/creds/terraform-role tenant_id   | ARM_TENANT_ID

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3

      - name: Terraform Init
        run: terraform init -input=false

      - name: Terraform Plan
        run: terraform plan -out=tfplan -input=false

      - name: Terraform Apply
        if: github.ref == 'refs/heads/main'
        run: terraform apply -input=false tfplan
