name: Azure Terraform Deployment
on: [push]

permissions:
  id-token: write
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Fetch Azure Credentials from Vault
        uses: hashicorp/vault-action@v3
        with:
          url: http://20.244.121.53:8200
          role: gh-actions-role
          method: jwt
          secrets: |
            azure/creds/terraform-role client_id | ARM_CLIENT_ID ;
            azure/creds/terraform-role client_secret | ARM_CLIENT_SECRET

      - name: Set Azure Env Vars
        run: |
          echo "ARM_SUBSCRIPTION_ID=${{ secrets.AZURE_SUBSCRIPTION_ID }}" >> $GITHUB_ENV
          echo "ARM_TENANT_ID=${{ secrets.AZURE_TENANT_ID }}" >> $GITHUB_ENV

      - uses: hashicorp/setup-terraform@v3
      - run: terraform init
      - run: terraform plan
      - run: terraform apply -auto-approve
